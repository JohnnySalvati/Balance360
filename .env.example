# Plantilla de variables de entorno para PRODUCCIÓN en la VM.
# En la VM:  cp .env.example .env   y completá los valores reales.
# El archivo .env real NO se versiona (está en .gitignore).

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=balance360
POSTGRES_PASSWORD=CAMBIAR_por_una_password_fuerte
POSTGRES_DB=balance360

# ── App ─────────────────────────────────────────────────────
# 'db' es el nombre del servicio Postgres en el compose (red interna).
# Usá la MISMA password que pusiste en POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://balance360:CAMBIAR_por_una_password_fuerte@db:5432/balance360

# Generalo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CAMBIAR_por_un_secreto_aleatorio

AFIP_ENV=homo

# ── Dominio (lo usa Caddy para el HTTPS) ────────────────────
DOMAIN=balance360.tudominio.org

# ── Certificados AFIP ───────────────────────────────────────
# El código elige el par (clave + certificado) según AFIP_ENV.
# Apuntá a los archivos montados en la VM. En este proyecto homo
# y prod comparten la misma clave privada, pero podrías usar una
# distinta por ambiente.
HOMO_PRIVATE_KEY_PATH=/certs/homo_key.pem
HOMO_CERT_PATH=/certs/homo.crt
PROD_PRIVATE_KEY_PATH=/certs/homo_key.pem
PROD_CERT_PATH=/certs/production.crt
